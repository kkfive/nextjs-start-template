{
  "semverRange": false,
  "sortAz": false,
  "sortFirst": false,
  "semverGroups": [
    {
      "label": "不强制统一 semver range 格式（项目允许 ^/~ 等多种 range）",
      "dependencies": ["**"],
      "isIgnored": true
    }
  ],
  "versionGroups": [
    {
      "label": "peer dependencies 使用宽泛 range，不强制版本一致",
      "dependencies": ["**"],
      "dependencyTypes": ["peer"],
      "isIgnored": true
    },
    {
      "label": "workspace 内部引用不检查版本",
      "dependencies": ["@kkfive/**"],
      "isIgnored": true
    },
    {
      "label": "rpc type-only 引 api AppType（Hono RPC 端到端类型链例外，见 monorepo.rule）",
      "dependencies": ["api"],
      "isIgnored": true
    }
  ]
}
