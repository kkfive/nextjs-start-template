{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": ["NODE_ENV", "CI"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.md",
        "!**/*.test.*",
        "!**/*.spec.*",
        "!**/*.stories.*",
        "!**/__tests__/**"
      ],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_DEBUG",
        "NEXT_PUBLIC_GA_ID",
        "SKIP_ENV_VALIDATION"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "test:run": {
      "dependsOn": [],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "verify:architecture": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "scripts/verify-conventions.mjs",
        "apps/**",
        "packages/**",
        "internal/**"
      ]
    },
    "verify:fixtures": {
      "dependsOn": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "src/architecture-policy/**",
        "$TURBO_ROOT$/scripts/verify-conventions.mjs"
      ]
    }
  }
}
