{
  "name": "nextjs-start-template",
  "version": "0.0.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-angular": "^21.2.0",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint-react/eslint-plugin": "^5.12.1",
    "@kkfive/node-utils": "workspace:*",
    "lefthook": "^2.1.10",
    "syncpack": "^13.0.0",
    "taze": "^19.14.1",
    "turbo": "^2.5.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.10.0",
  "pnpm": {
    "strictPeerDependencies": true,
    "auto-install-peers": false,
    "verify-deps-before-run": true
  },
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "postinstall": "lefthook install",
    "preinstall": "npx only-allow pnpm",
    "test": "turbo run test",
    "test:run": "turbo run test:run",
    "typecheck": "turbo run typecheck",
    "up": "taze major -I -r",
    "verify": "pnpm run verify:conventions && pnpm run verify:deps",
    "verify:conventions": "node scripts/verify-conventions.mjs",
    "verify:deps": "syncpack lint"
  },
  "type": "module"
}
