# 镜像名称；本地默认使用 local，CI 应设置为镜像仓库地址。
IMAGE_REGISTRY=local
IMAGE_TAG=latest

# Client 的公开地址，会在前端构建阶段写入浏览器产物。
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 浏览器访问 API 的公开地址，会在前端构建阶段写入浏览器产物。
NEXT_PUBLIC_API_URL=http://localhost:8787

# Client 构建阶段使用的服务端 API 地址，不得包含密钥。
API_BUILD_BASE_URL=http://localhost:8787

# Client 容器运行时访问 API 的内部地址。
API_BASE_URL=http://api:8787

# 可选：Client 服务端没有 auth-token Cookie 时使用的兜底令牌。
# API_TOKEN=

# API 允许的浏览器来源，多个地址使用逗号分隔。
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# 本地端口映射。
CLIENT_PORT=3000
ADMIN_PORT=3001
API_PORT=8787
