{
  "name": "api",
  "version": "0.0.0",
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "@kkfive/contracts": "workspace:*",
    "@kkfive/domain-core": "workspace:*",
    "@kkfive/utils": "workspace:*",
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@kkfive/lint-config": "workspace:*",
    "@kkfive/tsconfig": "workspace:*",
    "@types/node": "^26.1.1",
    "eslint": "^10.6.0",
    "tsup": "^8.5.0",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3"
