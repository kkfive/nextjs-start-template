{
  "name": "api",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": {
      "types": "./src/app.ts",
      "default": "./src/app.ts"
    }
  },
  "scripts": {
    "build": "tsdown",
    "deploy:cloudflare": "wrangler deploy",
    "dev": "tsx watch src/server.ts",
    "dev:cloudflare": "wrangler dev",
    "start": "node dist/server.mjs",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "types:cloudflare": "wrangler types"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@kkfive/contracts": "workspace:*",
    "hono": "catalog:"
  },
  "devDependencies": {
    "@kkfive/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "wrangler": "catalog:"
  }
}
