# 环境变量配置
# 复制为 .env.local 后按需调整：
# cp .env.example .env.local

# 当前 Next.js 应用的公开地址。
# 服务端请求本应用 Route Handler 时使用；生产环境必须配置。
# 本地开发未配置时默认使用 http://localhost:5373。
NEXT_PUBLIC_APP_URL=http://localhost:5373

# Next.js 服务端访问 apps/api 时使用的内部地址。
# 本地开发未配置时默认使用 http://localhost:8787。
# Docker Compose 中通常配置为 http://api:8787。
API_BASE_URL=http://localhost:8787

# 浏览器访问 apps/api 时使用的公开地址。
# 该值会在 next build 阶段写入浏览器产物。
NEXT_PUBLIC_API_URL=http://localhost:8787

# 可选：没有 auth-token Cookie 时，服务端请求使用的兜底令牌。
# 这是服务端密钥，禁止改成 NEXT_PUBLIC_* 变量。
# API_TOKEN=
