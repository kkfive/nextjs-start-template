# ===========================================
# Environment Variables Configuration
# ===========================================
# Copy this file to .env.local and fill in your values
# cp .env.example .env.local

# ===========================================
# Application Settings
# ===========================================

# Current Next application origin, used by server-side requests to its Route Handlers.
# Required in production; local development defaults to http://localhost:5373.
NEXT_PUBLIC_APP_URL=http://localhost:5373

# Application environment
# Options: development, staging, production
NODE_ENV=development

# ===========================================
# API Configuration
# ===========================================

# External apps/api (Hono) origin for server-side RPC only.
# Local development defaults to http://localhost:8787.
API_BASE_URL=http://localhost:8787

# External apps/api (Hono) origin for browser RPC only.
# Regular HTTP and SSE requests always use this Next application's /api handlers.
NEXT_PUBLIC_API_URL=http://localhost:8787

# ===========================================
# Authentication (Optional)
# ===========================================

# JWT Secret for token signing (server-side only)
# Generate with: openssl rand -base64 32
# JWT_SECRET=

# Session secret for cookie encryption
# SESSION_SECRET=

# ===========================================
# Database (Optional)
# ===========================================

# Database connection string
# Example: postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=

# ===========================================
# Third-party Services (Optional)
# ===========================================

# Analytics
# NEXT_PUBLIC_GA_ID=

# Error tracking
# SENTRY_DSN=

# ===========================================
# Feature Flags (Optional)
# ===========================================

# Enable debug mode
# NEXT_PUBLIC_DEBUG=false

# Enable maintenance mode
# MAINTENANCE_MODE=false
